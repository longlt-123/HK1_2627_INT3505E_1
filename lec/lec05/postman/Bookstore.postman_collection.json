{
  "info": {
    "name": "Bookstore — Lab 1, Lab 2, Homework 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "book_id",
      "value": ""
    },
    {
      "key": "isbn",
      "value": ""
    },
    {
      "key": "next_cursor",
      "value": ""
    },
    {
      "key": "first_ids",
      "value": "[]"
    }
  ],
  "item": [
    {
      "name": "01 List offset",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books?strategy=offset&limit=5&offset=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Five seeded books\", () => pm.expect(pm.response.json().data.length).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Filter and multi-key",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books?genre=technology&sort=-price,title&limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Technology only\", () => pm.response.json().data.forEach(b => pm.expect(b.category_id).to.eql(1)));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Cursor first page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books?strategy=cursor&sort=-price,title&genre=technology&limit=3"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"Next page exists\", () => pm.expect(b.meta.has_more).to.eql(true));",
              "pm.collectionVariables.set(\"next_cursor\", b.meta.next_cursor);",
              "pm.collectionVariables.set(\"first_ids\", JSON.stringify(b.data.map(x=>x.id)));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Cursor second page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books?strategy=cursor&sort=-price,title&genre=technology&limit=3&cursor={{next_cursor}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const ids = JSON.parse(pm.collectionVariables.get(\"first_ids\"));",
              "pm.test(\"No duplicates\", () => pm.response.json().data.forEach(b => pm.expect(ids).not.to.include(b.id)));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/books",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Postman Book\", \"isbn\": \"{{isbn}}\", \"price_vnd\": 120000, \"stock\": 5, \"category_id\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"isbn\", \"PM-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"book_id\", pm.response.json().id);",
              "pm.test(\"Location\", () => pm.expect(pm.response.headers.has(\"Location\")).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Read",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Duplicate ISBN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/books",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Postman Book\", \"isbn\": \"{{isbn}}\", \"price_vnd\": 120000, \"stock\": 5, \"category_id\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/books/{{book_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"stock\": 12}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Stock updated\", () => pm.expect(pm.response.json().stock).to.eql(12));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 PUT",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/books/{{book_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Postman Book\", \"isbn\": \"{{isbn}}\", \"price_vnd\": 120000, \"stock\": 5, \"category_id\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Invalid category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/books",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Postman Book\", \"isbn\": \"{{isbn}}\", \"price_vnd\": 120000, \"stock\": 5, \"category_id\": 999999}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Invalid sort",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books?sort=foo"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Invalid limit",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books?limit=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Invalid cursor",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books?strategy=cursor&cursor=broken"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Cursor filter mismatch",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books?strategy=cursor&sort=-price,title&genre=fiction&cursor={{next_cursor}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Delete",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/v1/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Missing book",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}